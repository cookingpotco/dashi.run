{
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "dashi",
    "lib": ["dom", "deno.ns", "deno.unstable"]
  },
  "unstable": ["bundle", "no-legacy-abort"],
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@cookingpot/dashi"]
  },
  "lock": {
    "frozen": true
  },
  "exclude": [".deno", "node_modules"],
  "fmt": {
    "useBraces": "always",
    "singleBodyPosition": "nextLine",
    "exclude": ["**/*.svg"]
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ],
      "include": [
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "tasks": {
    "css": "deno run -A css.ts",
    "css:watch": "deno run -A css.ts --watch",
    "dev": "deno run -A dev.ts"
  },
  "imports": {
    "dashi": "jsr:@cookingpot/dashi@^0.8.0",
    "tailwindcss": "npm:tailwindcss@4",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@4"
  }
}
